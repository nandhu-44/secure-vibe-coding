{
  "pack": "secrets",
  "rules": [
    {
      "id": "SV-SEC-001",
      "title": "Hardcoded AWS access key ID",
      "severity": "high",
      "cwe": "CWE-798",
      "owasp": "A04:2025",
      "langs": [
        "*"
      ],
      "patterns": [
        "\\b(AKIA|ASIA)[0-9A-Z]{16}\\b"
      ],
      "fix": "Remove the key, rotate it in AWS IAM, load credentials from the environment/IAM role.",
      "unless": "AKIAIOSFODNN7EXAMPLE",
      "comments": true
    },
    {
      "id": "SV-SEC-002",
      "title": "Hardcoded GitHub token",
      "severity": "high",
      "cwe": "CWE-798",
      "owasp": "A04:2025",
      "langs": [
        "*"
      ],
      "patterns": [
        "\\b(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36,}\\b",
        "\\bgithub_pat_[A-Za-z0-9_]{60,}\\b"
      ],
      "fix": "Revoke the token on GitHub and read it from an env var / CI secret.",
      "comments": true
    },
    {
      "id": "SV-SEC-003",
      "title": "Hardcoded Slack token",
      "severity": "high",
      "cwe": "CWE-798",
      "owasp": "A04:2025",
      "langs": [
        "*"
      ],
      "patterns": [
        "\\bxox[abprs]-[A-Za-z0-9-]{10,}"
      ],
      "fix": "Revoke the token and load it from a secret manager.",
      "comments": true
    },
    {
      "id": "SV-SEC-004",
      "title": "Hardcoded Stripe live secret key",
      "severity": "high",
      "cwe": "CWE-798",
      "owasp": "A04:2025",
      "langs": [
        "*"
      ],
      "patterns": [
        "\\b(sk|rk)_live_[A-Za-z0-9]{20,}"
      ],
      "fix": "Roll the key in the Stripe dashboard and load it from the environment server-side only.",
      "comments": true
    },
    {
      "id": "SV-SEC-005",
      "title": "Hardcoded LLM provider API key (OpenAI/Anthropic-style)",
      "severity": "high",
      "cwe": "CWE-798",
      "owasp": "A04:2025",
      "langs": [
        "*"
      ],
      "patterns": [
        "\\bsk-(ant-[a-z0-9]+-|proj-)?[A-Za-z0-9_-]{32,}"
      ],
      "fix": "Revoke the key and read it from an env var on the server; never ship it to the browser.",
      "unless": "(?i)(\\$\\{|\\{\\{|<[a-z_ -]+>|your[_-]|example|changeme|change_me|placeholder|xxxx|\\*\\*\\*|dummy|fake|redacted|not[_-]?a[_-]?real|replace[_-]?me|process\\.env|os\\.environ|getenv|import\\.meta\\.env|secrets\\.|vault:)",
      "comments": true
    },
    {
      "id": "SV-SEC-006",
      "title": "Hardcoded Google API key",
      "severity": "high",
      "cwe": "CWE-798",
      "owasp": "A04:2025",
      "langs": [
        "*"
      ],
      "patterns": [
        "\\bAIza[0-9A-Za-z_-]{35}\\b"
      ],
      "fix": "Restrict/rotate the key in Google Cloud console and load it from config.",
      "comments": true
    },
    {
      "id": "SV-SEC-007",
      "title": "Private key material in source",
      "severity": "high",
      "cwe": "CWE-321",
      "owasp": "A04:2025",
      "langs": [
        "*"
      ],
      "patterns": [
        "-----BEGIN (RSA |EC |DSA |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY( BLOCK)?-----"
      ],
      "fix": "Move the key to a secret manager/KMS or a gitignored file; rotate it.",
      "comments": true
    },
    {
      "id": "SV-SEC-008",
      "title": "Credentials embedded in a connection URL",
      "severity": "high",
      "cwe": "CWE-798",
      "owasp": "A04:2025",
      "langs": [
        "code",
        "config"
      ],
      "patterns": [
        "\\b[a-z][a-z0-9+.-]*://[^\\s:/@'\\\"`]+:(?P<val>[^\\s@'\\\"`/$<{]{3,})@[^\\s'\\\"`]+"
      ],
      "fix": "Build the URL from env vars (e.g. DATABASE_URL) instead of embedding user:password.",
      "unless": "(?i):(password|pass|pwd|secret|changeme|x+|\\*+)@|(\\$\\{|\\{\\{|<[a-z_ -]+>|your[_-]|example|changeme|change_me|placeholder|xxxx|\\*\\*\\*|dummy|fake|redacted|not[_-]?a[_-]?real|replace[_-]?me|process\\.env|os\\.environ|getenv|import\\.meta\\.env|secrets\\.|vault:)",
      "comments": true
    },
    {
      "id": "SV-SEC-009",
      "title": "Hardcoded secret assigned to a credential-like variable",
      "severity": "high",
      "cwe": "CWE-798",
      "owasp": "A04:2025",
      "langs": [
        "code",
        "config"
      ],
      "patterns": [
        "(?i)\\b(api[_-]?key|apikey|secret[_-]?key|client[_-]?secret|access[_-]?token|auth[_-]?token|bearer[_-]?token|password|passwd|private[_-]?key|jwt[_-]?secret|signing[_-]?key|session[_-]?secret|secret)\\b[\\\"']?\\s*(:|=|:=|=>)\\s*[\\\"'](?P<val>[^\\\"'\\s]{8,})[\\\"']"
      ],
      "fix": "Read the value from an environment variable or secret manager and fail fast if it is missing.",
      "unless": "(?i)(\\$\\{|\\{\\{|<[a-z_ -]+>|your[_-]|example|changeme|change_me|placeholder|xxxx|\\*\\*\\*|dummy|fake|redacted|not[_-]?a[_-]?real|replace[_-]?me|process\\.env|os\\.environ|getenv|import\\.meta\\.env|secrets\\.|vault:)",
      "min_entropy": 3.0,
      "comments": true
    },
    {
      "id": "SV-SEC-010",
      "title": "Secret exposed to client-side bundle via public env prefix",
      "severity": "high",
      "cwe": "CWE-200",
      "owasp": "A04:2025",
      "langs": [
        "code",
        "config",
        "html"
      ],
      "patterns": [
        "\\b(NEXT_PUBLIC|VITE|REACT_APP|EXPO_PUBLIC|NUXT_PUBLIC|PUBLIC)_[A-Z0-9_]*(SECRET|API_KEY|APIKEY|TOKEN|PRIVATE|PASSWORD|SERVICE_ROLE)[A-Z0-9_]*",
        "dangerouslyAllowBrowser\\s*:\\s*true"
      ],
      "fix": "Anything with a public prefix ships to every visitor. Call the API from a server route and keep the key server-side.",
      "unless": "(?i)(PUBLISHABLE|ANON|FIREBASE|MAPS|SITE_KEY|RECAPTCHA|TURNSTILE|POSTHOG|SENTRY_DSN)",
      "comments": true
    }
  ]
}
