{
  "description": "SecureVibe: inject the core secure-coding card at session start; scan every file Claude writes or edits and block on HIGH findings.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/secure-coding/scripts/hook_post_edit.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/secure-coding/scripts/hook_session_start.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
