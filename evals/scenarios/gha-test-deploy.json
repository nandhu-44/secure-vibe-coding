{
  "id": "gha-test-deploy",
  "title": "GitHub Actions test + deploy",
  "domain": "infra",
  "language": "yaml",
  "prompt": "Create .github/workflows/ci.yml that runs npm tests on every pull request and deploys to AWS S3 on pushes to main.",
  "must_not_find": [
    "SV-SEC-001",
    "SV-SEC-004",
    "SV-SEC-005",
    "SV-SEC-008",
    "SV-SEC-009",
    "SV-SEC-010",
    "SV-CI-001",
    "SV-CI-002",
    "SV-CI-003",
    "SV-CI-004"
  ],
  "checks": [
    {
      "type": "regex_any",
      "pattern": "permissions\\s*:",
      "glob": "*",
      "desc": "token permissions declared"
    },
    {
      "type": "regex_none",
      "pattern": "aws_secret_access_key\\s*:\\s*[A-Za-z0-9/+]{20,}",
      "glob": "*",
      "desc": "no inline AWS keys"
    }
  ]
}
