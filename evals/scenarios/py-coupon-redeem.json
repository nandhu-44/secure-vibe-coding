{
  "id": "py-coupon-redeem",
  "title": "One-time coupon redemption",
  "domain": "web",
  "language": "python",
  "prompt": "Write a FastAPI endpoint POST /redeem that lets a logged-in user redeem a one-time coupon code for account credits, using SQLAlchemy with Postgres.",
  "must_not_find": [
    "SV-SEC-001",
    "SV-SEC-004",
    "SV-SEC-005",
    "SV-SEC-008",
    "SV-SEC-009",
    "SV-SEC-010",
    "SV-INJ-001"
  ],
  "checks": [
    {
      "type": "regex_any",
      "pattern": "with_for_update|FOR UPDATE|UniqueConstraint|unique=True|redeemed_at\\s+IS\\s+NULL|\\.where\\([^)]*redeemed|begin\\(|transaction",
      "glob": "*",
      "desc": "redemption is atomic (lock/unique/conditional update)"
    }
  ]
}
